// Names the donors and splits the clonotypes between them, then hands on to `per-donor`.
// Ephemeral: the donor list is data. A template of its own so `per-donor` can wait for the
// split's counts and run nothing for a donor without clonotypes.

self := import("@platforma-sdk/workflow-tengo:tpl")

exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
maps := import("@platforma-sdk/workflow-tengo:maps")
ll := import("@platforma-sdk/workflow-tengo:ll")
render := import("@platforma-sdk/workflow-tengo:render")
text := import("text")
json := import("json")

hilarySw := assets.importSoftware("@platforma-open/milaboratories.lineage-trees.hilary:main")
perDonorTpl := assets.importTemplate(":per-donor")

f := exec.formula

self.awaitState("params", "ResourceReady")
// Null resource when no donor column is picked.
self.awaitState("donorColumn", "ResourceReady")
// The tables are only handed on, so they are not awaited.

// Same prefix `merge` put on every id.
prefixed := func(index, id) {
	return index + "_" + id
}

// Name plus sorted domain; tells whether the donor column and a dataset share samples.
axisKey := func(axis) {
	key := axis.name
	domain := is_undefined(axis.domain) ? {} : axis.domain
	for k in maps.getKeys(domain) {
		key += "|" + k + "=" + domain[k]
	}
	return key
}

self.body(func(inputs) {
	params := inputs.params

	// With no donor column the whole input is one unnamed group.
	donors := []
	sampleToDonor := {}
	donorsTsv := ""
	if params.hasDonorColumn {
		// Datasets on another sample axis get no donor and skip clustering; `split` counts them and the model warns.
		donorAxisKey := axisKey(inputs.donorColumn.spec.axesSpec[0])
		covered := []
		for ds in params.datasets {
			if axisKey(ds.sampleAxis) == donorAxisKey {
				covered = append(covered, ds.index)
			}
		}

		// Strip tabs and newlines once, so every use of a donor name matches and no value shifts a column.
		clean := func(v) { return text.replace(text.replace(v, "\t", " ", -1), "\n", " ", -1) }
		donorSet := {}
		for key, value in inputs.donorColumn.data.getDataAsJson()["data"] {
			// Metadata may be numeric; donors are named and compared as text throughout.
			// No value or a blank one is no donor: the sample is left out, as the model warns.
			if is_undefined(value) {
				continue
			}
			donor := text.trim_space(clean(is_string(value) ? value : string(value)))
			if donor == "" {
				continue
			}
			sample := json.decode(key)[0]
			for index in covered {
				sampleToDonor[prefixed(index, sample)] = donor
			}
			donorSet[donor] = true
		}
		// Sorted, so two equivalent runs build the same graph and dedup.
		donors = maps.getKeys(donorSet)
		// Otherwise every group would be named by an undefined donor. The model warns before the run.
		if len(donors) == 0 {
			ll.panic("No sample in the picked datasets has a value in the donor column, so nothing can be clustered. Fill in the donor column or clear it.")
		}

		donorsTsv = "sample_id\tdonor\n"
		for sample in maps.getKeys(sampleToDonor) {
			donorsTsv += clean(sample) + "\t" + sampleToDonor[sample] + "\n"
		}
	}
	groupCount := len(donors) == 0 ? 1 : len(donors)

	// Per-donor files are numbered, not named: donor names are arbitrary text.

	splitCmd := exec.builder().
		software(hilarySw).
		// Measured at about 2.2x its inputs, like merge.
		resources({
			onCPU: {
				cpu: 1,
				ram: f.size("splitInput").times(4).plus(f.mib(512)).
					between(f.gib(1), f.gib(256)).staticFallback(f.gib(4))
			}
		}).
		addFile("clonotypes.tsv", inputs.clonotypeTable, { tag: "splitInput" }).
		addFile("abundance.tsv", inputs.abundanceTable, { tag: "splitInput" }).
		arg("split").
		arg("--clonotypes").arg("clonotypes.tsv").
		arg("--abundance").arg("abundance.tsv").
		arg("--out-dir").arg("split").
		arg("--out-counts").arg("counts.json")

	if params.hasDonorColumn {
		splitCmd.writeFile("donors.tsv", donorsTsv)
		splitCmd.arg("--donors").arg("donors.tsv")
		for donor in donors {
			splitCmd.arg("--donor").arg(donor)
		}
	}
	splitTables := {}
	for i := 0; i < groupCount; i++ {
		splitCmd.saveFile("split/donor-" + string(i) + ".tsv")
	}
	split := splitCmd.saveFileContent("counts.json").saveStdoutContent().printErrStreamToStdout().run()
	for i := 0; i < groupCount; i++ {
		splitTables[string(i)] = split.getFile("split/donor-" + string(i) + ".tsv")
	}
	clonotypeCounts := split.getFileContent("counts.json")

	perDonor := render.createEphemeral(perDonorTpl, {
		splitTables: splitTables,
		clonotypeCounts: clonotypeCounts,
		abundanceTable: inputs.abundanceTable,
		annotationsTable: inputs.annotationsTable,
		knownTable: inputs.knownTable,
		clns: inputs.clns,
		libraries: inputs.libraries,
		sampleMetadata: inputs.sampleMetadata,
		params: maps.merge(params, { donors: donors, donorsTsv: donorsTsv, sampleToDonor: sampleToDonor })
	})

	outputs := {
		// Per-donor counts, plus clonotypes shared between donors or placed nowhere.
		clusteringLog: split.getStdoutContent(),
		// Also a block output, so it outlives the run and the next one waits on nothing.
		donorClonotypes: clonotypeCounts
	}
	for key in ["allelesLogs", "alignmentsLogs", "clusteringLogs", "treesLogs", "collectLog",
		"alleleRoutes", "clusteringMethods", "nodes", "lineageStats", "nodeProperties",
		"nodeMetadata", "nodeAbundance", "donorStats", "runId", "treesLog", "resultsToCache"] {
		outputs[key] = perDonor.output(key)
	}
	for ds in params.datasets {
		idx := ds.index
		for key in ["lineages", "nodeLinks", "germlineMutations", "memberCounts", "knownDistances"] {
			outputs[key + "-" + idx] = perDonor.output(key + "-" + idx)
		}
		for knownDs in params.datasets {
			if knownDs.isKnown && knownDs.index != idx {
				pair := idx + "-" + knownDs.index
				outputs["knownLinks-" + pair] = perDonor.output("knownLinks-" + pair)
			}
		}
	}
	return outputs
})
