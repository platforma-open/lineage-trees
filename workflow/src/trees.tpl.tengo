// One donor's tree builds. Pure, and its outputs are kept by the block.

self := import("@platforma-sdk/workflow-tengo:tpl")

exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
maps := import("@platforma-sdk/workflow-tengo:maps")

immcantationSw := assets.importSoftware("@platforma-open/milaboratories.lineage-trees.immcantation:main")

f := exec.formula

// Output name to the file the tree step writes.
FILES := {
	lineages: "lineages.tsv",
	nodes: "nodes.tsv",
	nodeLinks: "node-links.tsv",
	builders: "builders.tsv",
	aaCdist: "aa-cdist.tsv",
	germlineMutations: "germline-mutations.tsv",
	consensus: "consensus.tsv",
	anchorDistances: "anchor-distances.tsv",
	treesLog: "trees.log"
}

self.defineOutputs("lineages", "nodes", "nodeLinks", "builders", "aaCdist", "germlineMutations",
	"consensus", "anchorDistances", "treesLog", "log")

self.body(func(inputs) {
	params := inputs.params

	// FastTree and RAxML run one single-threaded job per worker, so cores scale
	// linearly; IgPhyML is one heavy process.
	treeCPUs := params.igPhyMLScope != "none" ? 2 : 16
	treesCmd := exec.builder().
		software(immcantationSw).
		resources({
			onCPU: {
				cpu: treeCPUs,
				// The step held 13x aligned on a 1.08M-clonotype run (formula assumed 6x) and was killed
				// building its largest lineages. Requested generously; workers fill only part of it.
				ram: f.size("aligned").times(16).plus(f.gib(32)).
					between(f.gib(32), f.gib(256)).staticFallback(f.gib(48))
			}
		}).
		addFile("clonotypes.tsv", inputs.clonotypes).
		addFile("clones.tsv", inputs.clones).
		addFile("aligned.tsv", inputs.aligned, { tag: "aligned" }).
		addFile("annotations.tsv", inputs.anchors).
		addFile("abundance.tsv", inputs.abundance).
		arg("--stage").arg("trees").
		arg("--annotations").arg("annotations.tsv").
		arg("--clonotypes").arg("clonotypes.tsv").
		arg("--clones").arg("clones.tsv").
		arg("--aligned").arg("aligned.tsv").
		arg("--abundance").arg("abundance.tsv").
		arg("--igphyml-scope").arg(params.igPhyMLScope).
		arg("--threads").arg(string(treeCPUs)).
		arg("--out-log").arg("trees.log").
		arg("--out-lineages").arg("lineages.tsv").
		arg("--out-nodes").arg("nodes.tsv").
		arg("--out-node-links").arg("node-links.tsv").
		arg("--out-builders").arg("builders.tsv").
		arg("--out-aa-cdist").arg("aa-cdist.tsv").
		arg("--out-germline-mutations").arg("germline-mutations.tsv").
		arg("--out-consensus").arg("consensus.tsv").
		arg("--out-anchor-distances").arg("anchor-distances.tsv").
		saveStdoutStream().
		printErrStreamToStdout()
	for name in maps.getKeys(FILES) {
		treesCmd.saveFile(FILES[name])
	}

	if params.useLightChains {
		treesCmd.arg("--light-chains")
	}
	// Unset means no cap, only the structural floor of two tips.
	if !is_undefined(params.maxTipsPerTree) {
		treesCmd.arg("--max-tips").arg(string(params.maxTipsPerTree))
	}
	if !is_undefined(params.minTipsPerTree) {
		treesCmd.arg("--min-tips").arg(string(params.minTipsPerTree))
	}

	trees := treesCmd.run()
	out := { log: trees.getStdoutStream() }
	for name in maps.getKeys(FILES) {
		out[name] = trees.getFile(FILES[name])
	}
	return out
})
